{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenChart",
  "version": "0.1.0",
  "identifier": "ai.openchart.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "OpenChart AI contributors",
    "copyright": "AGPL-3.0-or-later",
    "category": "Finance",
    "shortDescription": "Chart-first investment research, on your own computer",
    "longDescription": "OpenChart AI runs its database and service on this computer. Your workspace stays here unless you export it.",
    "homepage": "https://github.com/Jamireoicgamer/Opencharts",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/postgres/": "postgres/",
      "../build/api/": "api/",
      "../build/web/": "web/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
