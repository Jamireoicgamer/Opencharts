# Local development settings for the API (copy to .env).
# Docker installs use ./secrets instead; see scripts/gen-secrets.sh.

# Least-privilege role the API connects as (row-level security applies to it).
OPENCHART_DATABASE_URL=postgresql+asyncpg://openchart_app:CHANGE_ME@127.0.0.1:5432/openchart
# Schema owner, used only by `uv run openchart-api migrate`.
OPENCHART_MIGRATE_DATABASE_URL=postgresql+asyncpg://openchart_owner:CHANGE_ME@127.0.0.1:5432/openchart
# 32 random bytes, base64. Generate with: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
OPENCHART_MASTER_KEY=
# Optional: public URL of the web app (enables Secure cookies when https).
# OPENCHART_PUBLIC_ORIGIN=https://charts.example.com
